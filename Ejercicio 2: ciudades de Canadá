%Regla nodos
arista(X) :- con(X, [_|_]).
pertenece(X, [X|_]).
pertenece(X, [_|T]) :- pertenece(X, T).
no_pertenece(_, []).
no_pertenece(X, [H|T]) :- X \== H, no_pertenece(X, T).
conectado(X, Y, Costo) :- con(X, Lista), pertenece(destino(Y, Costo), Lista).

%Regla para costo de un nodo de X a un Z a un Y
camino(X, Z, Costo) :- camino(X, Z, [X], Costo).
camino(X, Z, _, Costo) :- conectado(X, Z, Costo).
camino(X, Z, Visitadas, Total) :- conectado(X, Y, Costo1), no_pertenece(Y, Visitadas), camino(Y, Z, [Y|Visitadas], Costo2), Total is Costo1 + Costo2.

%Regla para costo de X a Z pasando por Y
pasando_por(X, Y, Z, Total) :- camino(X, Y, Costo1), camino(Y, Z, Costo2), Total is Costo1 + Costo2.
